# Fastlane automation for the DinnerOS iOS app.
#
# Lanes:
#   bundle exec fastlane test   — run unit tests on the simulator
#   bundle exec fastlane beta   — archive, sign, and upload to TestFlight
#
#   bundle exec fastlane signing — create or renew the shared certificate
#
# Signing uses fastlane match: one Apple Distribution certificate and one
# App Store profile, encrypted in a private repository, shared by every machine
# and CI run. `beta` reads them (readonly), so a build never creates or revokes
# a certificate; `signing` is the only lane that writes. Required environment
# variables are documented in docs/deployment.md.

require "base64"
require "shellwords"
require "tempfile"

default_platform(:ios)

PROJECT = "DinnerOS.xcodeproj"
SCHEME = "DinnerOS"
DEFAULT_BUNDLE_ID = "com.linesmerrill.dinneros"
TEST_DEVICE = "iPhone 17 Pro"

def asc_api_key
  required = %w[APP_STORE_CONNECT_KEY_ID APP_STORE_CONNECT_ISSUER_ID APP_STORE_CONNECT_PRIVATE_KEY DEVELOPMENT_TEAM]
  missing = required.select { |name| ENV[name].to_s.strip.empty? }
  UI.user_error!("Missing required environment variables: #{missing.join(', ')}") unless missing.empty?

  app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
    key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
    is_key_content_base64: !ENV["APP_STORE_CONNECT_PRIVATE_KEY"].to_s.include?("BEGIN PRIVATE KEY")
  )
end

platform :ios do
  desc "Run unit tests"
  lane :test do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      device: TEST_DEVICE,
      xcargs: "CODE_SIGNING_ALLOWED=NO"
    )
  end

  desc "Build a Release archive and upload it to TestFlight for internal testers"
  lane :beta do
    # CI has no unlocked keychain, so codesign would block on a prompt after
    # match imports the certificate. This creates a temporary one.
    setup_ci if is_ci
    bundle_id = ENV.fetch("APP_BUNDLE_ID", DEFAULT_BUNDLE_ID)
    api_key = asc_api_key

    # Read the shared certificate and profile. Nothing is created here, so a
    # build can never add a certificate to the account.
    match(type: "appstore", app_identifier: bundle_id, api_key: api_key, readonly: true)
    profile_name = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]&.dig(bundle_id) ||
                   ENV["sigh_#{bundle_id}_appstore_profile-name"]
    UI.user_error!("match did not install a profile for #{bundle_id}") if profile_name.to_s.empty?

    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: bundle_id,
      initial_build_number: 0
    ) + 1

    build_settings = [
      "DEVELOPMENT_TEAM=#{ENV['DEVELOPMENT_TEAM'].shellescape}",
      "CURRENT_PROJECT_VERSION=#{build_number}",
      "CODE_SIGN_STYLE=Manual",
      # The value has a space, so it has to survive the shell as one argument.
      "CODE_SIGN_IDENTITY=#{'Apple Distribution'.shellescape}",
      "PROVISIONING_PROFILE_SPECIFIER=#{profile_name.shellescape}"
    ]
    build_settings << "API_BASE_URL=#{ENV['API_BASE_URL'].shellescape}" unless ENV["API_BASE_URL"].to_s.empty?

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      clean: true,
      xcargs: build_settings.join(" "),
      export_options: {
        signingStyle: "manual",
        teamID: ENV["DEVELOPMENT_TEAM"],
        provisioningProfiles: { bundle_id => profile_name }
      }
    )

    # Internal testers receive builds through an internal group with automatic
    # distribution enabled in App Store Connect (see docs/deployment.md).
    # TESTFLIGHT_EXTERNAL_GROUPS (comma-separated group names) also hands each build to
    # external groups and submits it for Beta App Review. External distribution needs
    # the processed build, so that path waits for processing instead of skipping it.
    external_groups = ENV.fetch("TESTFLIGHT_EXTERNAL_GROUPS", "").split(",").map(&:strip).reject(&:empty?)
    if external_groups.empty?
      upload_to_testflight(
        api_key: api_key,
        app_identifier: bundle_id,
        skip_waiting_for_build_processing: true,
        distribute_external: false
      )
    else
      # The commit subject; the body and trailers are for developers, not testers.
      changelog = ENV.fetch("TESTFLIGHT_CHANGELOG", "").lines.first.to_s.strip
      changelog = "Bug fixes and improvements." if changelog.empty?
      begin
        upload_to_testflight(
          api_key: api_key,
          app_identifier: bundle_id,
          distribute_external: true,
          groups: external_groups,
          changelog: changelog,
          notify_external_testers: true,
          submit_beta_review: true,
          uses_non_exempt_encryption: false,
          wait_processing_timeout_duration: 2400
        )
      rescue => e
        # Apple allows one build per version in Beta App Review at a time. The upload
        # itself already succeeded and internal testers have the build, so a busy review
        # queue is a warning: the next build is submitted once the review finishes.
        raise unless e.message.include?("Another build is in review")
        UI.important("Uploaded, but not sent to #{external_groups.join(', ')}: another build is still in Beta App Review.")
      end
    end
  end

  desc "Create or renew the shared signing certificate and profile in the match repository"
  lane :signing do
    setup_ci if is_ci
    bundle_id = ENV.fetch("APP_BUNDLE_ID", DEFAULT_BUNDLE_ID)
    UI.user_error!("MATCH_PASSWORD is required") if ENV["MATCH_PASSWORD"].to_s.strip.empty?

    match(type: "appstore", app_identifier: bundle_id, api_key: asc_api_key, readonly: false)
    UI.success("Signing assets are stored for #{bundle_id}; every machine and CI run now shares them.")
  end
end
