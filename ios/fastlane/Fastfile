# Fastlane automation for the DinnerOS iOS app.
#
# Lanes:
#   bundle exec fastlane test   — run unit tests on the simulator
#   bundle exec fastlane beta   — archive, sign, and upload to TestFlight
#
# `beta` uses an App Store Connect API key plus Xcode cloud-managed signing,
# so no certificates or provisioning profiles live in the repository. Required
# environment variables are documented in docs/deployment.md.

require "base64"
require "shellwords"
require "tempfile"

default_platform(:ios)

PROJECT = "DinnerOS.xcodeproj"
SCHEME = "DinnerOS"
DEFAULT_BUNDLE_ID = "com.linesmerrill.dinneros"
TEST_DEVICE = "iPhone 17 Pro"

platform :ios do
  desc "Run unit tests"
  lane :test do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      device: TEST_DEVICE,
      xcargs: "CODE_SIGNING_ALLOWED=NO"
    )
  end

  desc "Build a Release archive and upload it to TestFlight for internal testers"
  lane :beta do
    required = %w[
      APP_STORE_CONNECT_KEY_ID
      APP_STORE_CONNECT_ISSUER_ID
      APP_STORE_CONNECT_PRIVATE_KEY
      DEVELOPMENT_TEAM
    ]
    missing = required.select { |name| ENV[name].to_s.strip.empty? }
    UI.user_error!("Missing required environment variables: #{missing.join(', ')}") unless missing.empty?

    bundle_id = ENV.fetch("APP_BUNDLE_ID", DEFAULT_BUNDLE_ID)

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      is_key_content_base64: ENV["APP_STORE_CONNECT_PRIVATE_KEY"].to_s.include?("BEGIN PRIVATE KEY") ? false : true
    )

    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: bundle_id,
      initial_build_number: 0
    ) + 1

    # xcodebuild needs the key on disk for cloud-managed signing. Write it to a
    # temporary file outside the repository and always remove it.
    key_file = Tempfile.new(["AuthKey", ".p8"])
    begin
      key_file.write(api_key[:is_key_content_base64] ? Base64.decode64(api_key[:key]) : api_key[:key])
      key_file.close

      auth_args = [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{key_file.path.shellescape}",
        "-authenticationKeyID #{ENV['APP_STORE_CONNECT_KEY_ID'].shellescape}",
        "-authenticationKeyIssuerID #{ENV['APP_STORE_CONNECT_ISSUER_ID'].shellescape}"
      ]
      build_settings = [
        "DEVELOPMENT_TEAM=#{ENV['DEVELOPMENT_TEAM'].shellescape}",
        "CURRENT_PROJECT_VERSION=#{build_number}"
      ]
      build_settings << "API_BASE_URL=#{ENV['API_BASE_URL'].shellescape}" unless ENV["API_BASE_URL"].to_s.empty?

      build_app(
        project: PROJECT,
        scheme: SCHEME,
        configuration: "Release",
        export_method: "app-store",
        output_directory: "build",
        clean: true,
        # gym forwards xcargs to both archive and export, so the auth flags must
        # appear only once (xcodebuild rejects duplicates).
        xcargs: (auth_args + build_settings).join(" "),
        export_options: {
          signingStyle: "automatic",
          teamID: ENV["DEVELOPMENT_TEAM"]
        }
      )
    ensure
      key_file.unlink
    end

    upload_to_testflight(
      api_key: api_key,
      app_identifier: bundle_id,
      # Internal testers receive builds through an internal group with automatic
      # distribution enabled in App Store Connect (see docs/deployment.md).
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
