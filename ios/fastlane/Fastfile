# Fastlane automation for the DinnerOS iOS app.
#
# Lanes:
#   bundle exec fastlane test   — run unit tests on the simulator
#   bundle exec fastlane beta   — archive, sign, and upload to TestFlight
#
#   bundle exec fastlane signing — create or renew the shared certificate
#
# Signing uses fastlane match: one Apple Distribution certificate and one
# App Store profile per bundle identifier — the app and its Live Activities
# widget extension — encrypted in a private repository, shared by every machine
# and CI run. `beta` reads them (readonly), so a build never creates or revokes
# a certificate; `signing` is the only lane that writes, and it also registers
# the extension's App ID on the Developer portal when it is missing. Required
# environment variables are documented in docs/deployment.md.

require "base64"
require "shellwords"
require "tempfile"

default_platform(:ios)

PROJECT = "DinnerOS.xcodeproj"
SCHEME = "DinnerOS"
DEFAULT_BUNDLE_ID = "com.linesmerrill.dinneros"
# The widget extension that draws Live Activities. Must match
# LIVE_ACTIVITIES_BUNDLE_ID in ios/Config/Shared.xcconfig.
LIVE_ACTIVITIES_SUFFIX = ".LiveActivities"
# The Safari share sheet extension that saves recipe links. Must match
# SHARE_BUNDLE_ID in ios/Config/Shared.xcconfig.
SHARE_SUFFIX = ".ShareExtension"
TEST_DEVICE = "iPhone 17 Pro"

def app_bundle_id
  ENV.fetch("APP_BUNDLE_ID", DEFAULT_BUNDLE_ID)
end

def live_activities_bundle_id
  ENV.fetch("LIVE_ACTIVITIES_BUNDLE_ID", "#{app_bundle_id}#{LIVE_ACTIVITIES_SUFFIX}")
end

def share_bundle_id
  ENV.fetch("SHARE_BUNDLE_ID", "#{app_bundle_id}#{SHARE_SUFFIX}")
end

# Every identifier that is signed into the archive, app first.
def signed_bundle_ids
  [app_bundle_id, live_activities_bundle_id, share_bundle_id]
end

# The name of the App Store profile match installed for identifier.
def match_profile_name(identifier)
  name = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]&.dig(identifier) ||
         ENV["sigh_#{identifier}_appstore_profile-name"]
  UI.user_error!("match did not install a profile for #{identifier}; run the signing lane once (docs/deployment.md)") if name.to_s.empty?
  name
end

# Registers an explicit App ID on the Developer portal unless it exists, using
# the App Store Connect API key app_store_connect_api_key already put on the
# Spaceship session. No capabilities are added: the extension needs none.
def ensure_bundle_id(identifier, name)
  if Spaceship::ConnectAPI::BundleId.find(identifier)
    UI.message("App ID #{identifier} is registered.")
    return
  end
  # The App Store Connect API's POST /v1/bundleIds. The seed ID is the App ID
  # prefix, which for this team is the team ID.
  Spaceship::ConnectAPI::BundleId.create(
    name: name,
    identifier: identifier,
    platform: "IOS",
    seed_id: ENV["DEVELOPMENT_TEAM"]
  )
  UI.success("Registered App ID #{identifier} (#{name}).")
end

CompactAppID = "com.linesmerrill.dinneros"

# The Plus subscription group (App Store Connect, "DinnerOS Plus").
PLUS_GROUP_ID = "22576115"

# Gives each Plus subscription its review screenshot and adds it to the next
# App Review submission, through the App Store Connect API. Apple reviews a
# first subscription only with an app version.
def attach_plus_subscriptions(screens_dir, queue:)
  client = Spaceship::ConnectAPI.client.tunes_request_client
  list = -> { client.get("v1/subscriptionGroups/#{PLUS_GROUP_ID}/subscriptions").body["data"].to_a }
  subs = list.call
  UI.user_error!("No subscriptions in group #{PLUS_GROUP_ID}") if subs.empty?
  # First give each one what review needs, then queue them once Apple shows
  # them ready: the state takes a moment to catch up.
  subs.each do |sub|
    product = sub.dig("attributes", "productId")
    shot = File.join(screens_dir, product.end_with?(".yearly") ? "plus-review-yearly.png" : "plus-review-monthly.png")
    upload_review_screenshot(client, sub["id"], shot)
    make_subscription_available(client, sub["id"], product)
  end
  return unless queue

  pending = subs.map { |s| s["id"] }
  10.times do
    list.call.select { |s| pending.include?(s["id"]) }.each do |sub|
      product = sub.dig("attributes", "productId")
      case sub.dig("attributes", "state")
      when "WAITING_FOR_REVIEW", "IN_REVIEW", "APPROVED"
        UI.message("#{product} is already #{sub.dig('attributes', 'state')}.")
        pending.delete(sub["id"])
      when "READY_TO_SUBMIT"
        client.post("v1/subscriptionSubmissions", {
          data: { type: "subscriptionSubmissions",
                  relationships: { subscription: { data: { type: "subscriptions", id: sub["id"] } } } }
        })
        UI.success("#{product} will be reviewed with the app.")
        pending.delete(sub["id"])
      end
    end
    break if pending.empty?
    sleep(10)
  end
  UI.user_error!("Some Plus subscriptions never became ready: #{pending.join(', ')}") unless pending.empty?
end

# Sets the app's price to free and makes it available in every country, through
# the current App Store Connect API (fastlane's price_tier uses a retired one).
# Both are skipped once set.
def make_free_everywhere(app_id)
  client = Spaceship::ConnectAPI.client.tunes_request_client
  schedule = (client.get("v1/apps/#{app_id}/appPriceSchedule?include=manualPrices").body rescue {})
  if schedule.dig("data", "id") && !schedule.dig("data", "relationships", "manualPrices", "data").to_a.empty?
    UI.message("The app already has a price.")
  else
    points = client.get("v1/apps/#{app_id}/appPricePoints?filter[territory]=USA&limit=200").body["data"]
    free = points.find { |pt| pt.dig("attributes", "customerPrice").to_f.zero? }
    UI.user_error!("No free price point found") unless free
    client.post("v1/appPriceSchedules", {
      data: { type: "appPriceSchedules", relationships: {
        app: { data: { type: "apps", id: app_id } },
        baseTerritory: { data: { type: "territories", id: "USA" } },
        manualPrices: { data: [{ type: "appPrices", id: "${price}" }] }
      } },
      included: [{ type: "appPrices", id: "${price}", attributes: { startDate: nil },
                   relationships: { appPricePoint: { data: { type: "appPricePoints", id: free["id"] } } } }]
    })
    UI.success("The app is free.")
  end
  existing = (client.get("v1/apps/#{app_id}/appAvailabilityV2").body["data"] rescue nil)
  if existing
    UI.message("The app already has its countries.")
    return
  end
  territories = client.get("v1/territories?limit=200").body["data"].map { |t| t["id"] }
  client.post("v2/appAvailabilities", {
    data: { type: "appAvailabilities", attributes: { availableInNewTerritories: true }, relationships: {
      app: { data: { type: "apps", id: app_id } },
      territoryAvailabilities: { data: territories.map { |t| { type: "territoryAvailabilities", id: "${#{t}}" } } }
    } },
    included: territories.map do |t|
      { type: "territoryAvailabilities", id: "${#{t}}", attributes: { available: true },
        relationships: { territory: { data: { type: "territories", id: t } } } }
    end
  })
  UI.success("The app is available in #{territories.size} countries and regions.")
end

def asc_text(dir, name)
  path = File.join(dir, name)
  File.file?(path) ? File.read(path, encoding: "UTF-8").strip : nil
end

# The listing, straight through the API: this fastlane's deliver didn't save it.
def set_listing(app_id, meta, contact)
  client = Spaceship::ConnectAPI.client.tunes_request_client
  en = File.join(meta, "en-US")
  version = Spaceship::ConnectAPI::App.find(CompactAppID).get_edit_app_store_version
  client.patch("v1/appStoreVersions/#{version.id}", {
    data: { type: "appStoreVersions", id: version.id,
            attributes: { copyright: asc_text(meta, "copyright.txt"), releaseType: "MANUAL" } }
  })
  loc = client.get("v1/appStoreVersions/#{version.id}/appStoreVersionLocalizations").body["data"].find { |l| l.dig("attributes", "locale") == "en-US" }
  client.patch("v1/appStoreVersionLocalizations/#{loc['id']}", {
    data: { type: "appStoreVersionLocalizations", id: loc["id"], attributes: {
      description: asc_text(en, "description.txt"), keywords: asc_text(en, "keywords.txt"),
      promotionalText: asc_text(en, "promotional_text.txt"), supportUrl: asc_text(en, "support_url.txt"),
      marketingUrl: asc_text(en, "marketing_url.txt")
    } }
  })
  info = client.get("v1/apps/#{app_id}/appInfos").body["data"].find { |i| i.dig("attributes", "appStoreState") != "READY_FOR_SALE" }
  client.patch("v1/appInfos/#{info['id']}", {
    data: { type: "appInfos", id: info["id"], relationships: {
      primaryCategory: { data: { type: "appCategories", id: asc_text(meta, "primary_category.txt") } },
      secondaryCategory: { data: { type: "appCategories", id: asc_text(meta, "secondary_category.txt") } }
    } }
  })
  iloc = client.get("v1/appInfos/#{info['id']}/appInfoLocalizations").body["data"].find { |l| l.dig("attributes", "locale") == "en-US" }
  client.patch("v1/appInfoLocalizations/#{iloc['id']}", {
    data: { type: "appInfoLocalizations", id: iloc["id"], attributes: {
      name: asc_text(en, "name.txt"), subtitle: asc_text(en, "subtitle.txt"), privacyPolicyUrl: asc_text(en, "privacy_url.txt")
    } }
  })
  detail = client.get("v1/appStoreVersions/#{version.id}/appStoreReviewDetail").body["data"] rescue nil
  attrs = { contactFirstName: contact["first_name"], contactLastName: contact["last_name"],
            contactEmail: contact["email_address"], contactPhone: contact["phone_number"],
            notes: asc_text(File.join(meta, "review_information"), "notes.txt"), demoAccountRequired: false }
  if detail
    client.patch("v1/appStoreReviewDetails/#{detail['id']}", { data: { type: "appStoreReviewDetails", id: detail["id"], attributes: attrs } })
  else
    client.post("v1/appStoreReviewDetails", { data: { type: "appStoreReviewDetails", attributes: attrs,
      relationships: { appStoreVersion: { data: { type: "appStoreVersions", id: version.id } } } } })
  end
  UI.success("The listing, categories and review contact are saved.")
end

# Uploads one file through an App Store Connect asset reservation.
def asc_upload(client, kind, rel_name, rel_type, rel_id, path)
  bytes = File.binread(path)
  res = client.post("v1/#{kind}", { data: { type: kind,
    attributes: { fileName: File.basename(path), fileSize: bytes.bytesize },
    relationships: { rel_name => { data: { type: rel_type, id: rel_id } } } } }).body["data"]
  res.dig("attributes", "uploadOperations").each do |op|
    headers = op["requestHeaders"].to_h { |h| [h["name"], h["value"]] }
    Faraday.new.run_request(op["method"].downcase.to_sym, op["url"], bytes.byteslice(op["offset"], op["length"]), headers)
  end
  client.patch("v1/#{kind}/#{res['id']}", { data: { type: kind, id: res["id"],
    attributes: { uploaded: true, sourceFileChecksum: Digest::MD5.hexdigest(bytes) } } })
end

# The 13" iPad slot, which this fastlane files under the older 12.9" one.
def upload_ipad_13(app_id, dir)
  client = Spaceship::ConnectAPI.client.tunes_request_client
  version = Spaceship::ConnectAPI::App.find(CompactAppID).get_edit_app_store_version
  loc = client.get("v1/appStoreVersions/#{version.id}/appStoreVersionLocalizations").body["data"].find { |l| l.dig("attributes", "locale") == "en-US" }
  sets = client.get("v1/appStoreVersionLocalizations/#{loc['id']}/appScreenshotSets").body["data"]
  target = sets.find { |st| st.dig("attributes", "screenshotDisplayType") == "APP_IPAD_PRO_3GEN_129" }
  # Replace what's there, so retaken screenshots go up too.
  if target
    client.get("v1/appScreenshotSets/#{target['id']}/appScreenshots").body["data"].each do |old|
      client.delete("v1/appScreenshots/#{old['id']}")
    end
  end
  target ||=client.post("v1/appScreenshotSets", { data: { type: "appScreenshotSets",
    attributes: { screenshotDisplayType: "APP_IPAD_PRO_3GEN_129" },
    relationships: { appStoreVersionLocalization: { data: { type: "appStoreVersionLocalizations", id: loc["id"] } } } } }).body["data"]
  Dir[File.join(dir, "*.png")].sort.each do |f|
    asc_upload(client, "appScreenshots", "appScreenshotSet", "appScreenshotSets", target["id"], f)
  end
  sets.select { |st| st.dig("attributes", "screenshotDisplayType") == "APP_IPAD_PRO_129" }.each do |old|
    client.delete("v1/appScreenshotSets/#{old['id']}")
  end
  UI.success("Uploaded the 13\" iPad screenshots.")
end

# The app's Content Rights answer, or nil before Merrill gives it.
def app_content_rights(app_id)
  Spaceship::ConnectAPI.client.tunes_request_client.get("v1/apps/#{app_id}").body.dig("data", "attributes", "contentRightsDeclaration")
end

# Age rating answers (docs/app-store.md). Every content question is None; the
# one yes is user-generated content, since households can share recipes with
# other households. Only blank answers are filled.
AGE_RATING = {
  "alcoholTobaccoOrDrugUseOrReferences" => "NONE", "contests" => "NONE", "gamblingSimulated" => "NONE",
  "gunsOrOtherWeapons" => "NONE", "horrorOrFearThemes" => "NONE", "matureOrSuggestiveThemes" => "NONE",
  "medicalOrTreatmentInformation" => "NONE", "profanityOrCrudeHumor" => "NONE",
  "sexualContentGraphicAndNudity" => "NONE", "sexualContentOrNudity" => "NONE",
  "violenceCartoonOrFantasy" => "NONE", "violenceRealistic" => "NONE",
  "violenceRealisticProlongedGraphicOrSadistic" => "NONE",
  "advertising" => false, "gambling" => false, "healthOrWellnessTopics" => false, "lootBox" => false,
  "messagingAndChat" => false, "parentalControls" => false, "ageAssurance" => false, "socialMedia" => false,
  "unrestrictedWebAccess" => false, "userGeneratedContent" => true
}.freeze

def set_age_rating(app_id)
  client = Spaceship::ConnectAPI.client.tunes_request_client
  info = client.get("v1/apps/#{app_id}/appInfos").body["data"].find { |i| i.dig("attributes", "appStoreState") != "READY_FOR_SALE" }
  decl = client.get("v1/appInfos/#{info['id']}/ageRatingDeclaration").body["data"]
  blank = AGE_RATING.select { |k, _| decl.dig("attributes", k).nil? }
  if blank.empty?
    UI.message("The age rating is answered.")
    return
  end
  client.patch("v1/ageRatingDeclarations/#{decl['id']}", {
    data: { type: "ageRatingDeclarations", id: decl["id"], attributes: blank }
  })
  UI.success("Answered #{blank.size} age rating questions.")
end

# A subscription needs its countries before Apple will review it.
def make_subscription_available(client, subscription_id, product)
  existing = (client.get("v1/subscriptions/#{subscription_id}/subscriptionAvailability").body["data"] rescue nil)
  if existing
    UI.message("#{product} already has its countries.")
    return
  end
  territories = client.get("v1/territories?limit=200").body["data"].map { |t| { type: "territories", id: t["id"] } }
  client.post("v1/subscriptionAvailabilities", {
    data: { type: "subscriptionAvailabilities", attributes: { availableInNewTerritories: true }, relationships: {
      subscription: { data: { type: "subscriptions", id: subscription_id } },
      availableTerritories: { data: territories }
    } }
  })
  UI.success("#{product} is available in #{territories.size} countries and regions.")
end

def upload_review_screenshot(client, subscription_id, path)
  existing = client.get("v1/subscriptions/#{subscription_id}/appStoreReviewScreenshot").body["data"] rescue nil
  if existing
    UI.message("Review screenshot already set for subscription #{subscription_id}.")
    return
  end
  bytes = File.binread(path)
  reservation = client.post("v1/subscriptionAppStoreReviewScreenshots", {
    data: { type: "subscriptionAppStoreReviewScreenshots",
            attributes: { fileName: File.basename(path), fileSize: bytes.bytesize },
            relationships: { subscription: { data: { type: "subscriptions", id: subscription_id } } } }
  }).body["data"]
  reservation.dig("attributes", "uploadOperations").each do |op|
    part = bytes.byteslice(op["offset"], op["length"])
    headers = op["requestHeaders"].to_h { |h| [h["name"], h["value"]] }
    Faraday.new.run_request(op["method"].downcase.to_sym, op["url"], part, headers)
  end
  client.patch("v1/subscriptionAppStoreReviewScreenshots/#{reservation['id']}", {
    data: { type: "subscriptionAppStoreReviewScreenshots", id: reservation["id"],
            attributes: { uploaded: true, sourceFileChecksum: Digest::MD5.hexdigest(bytes) } }
  })
  UI.success("Uploaded the review screenshot for subscription #{subscription_id}.")
end

def asc_api_key
  required = %w[APP_STORE_CONNECT_KEY_ID APP_STORE_CONNECT_ISSUER_ID APP_STORE_CONNECT_PRIVATE_KEY DEVELOPMENT_TEAM]
  missing = required.select { |name| ENV[name].to_s.strip.empty? }
  UI.user_error!("Missing required environment variables: #{missing.join(', ')}") unless missing.empty?

  app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
    key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
    is_key_content_base64: !ENV["APP_STORE_CONNECT_PRIVATE_KEY"].to_s.include?("BEGIN PRIVATE KEY")
  )
end

platform :ios do
  desc "Run unit tests"
  lane :test do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      device: TEST_DEVICE,
      xcargs: "CODE_SIGNING_ALLOWED=NO"
    )
  end

  desc "Build a Release archive and upload it to TestFlight for internal testers"
  lane :beta do
    # CI has no unlocked keychain, so codesign would block on a prompt after
    # match imports the certificate. This creates a temporary one.
    setup_ci if is_ci
    bundle_id = app_bundle_id
    extension_id = live_activities_bundle_id
    api_key = asc_api_key

    # Read the shared certificate and both profiles. Nothing is created here, so
    # a build can never add a certificate to the account.
    match(type: "appstore", app_identifier: signed_bundle_ids, api_key: api_key, readonly: true)
    profile_name = match_profile_name(bundle_id)
    extension_profile_name = match_profile_name(extension_id)
    share_id = share_bundle_id
    share_profile_name = match_profile_name(share_id)

    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: bundle_id,
      initial_build_number: 0
    ) + 1

    build_settings = [
      "DEVELOPMENT_TEAM=#{ENV['DEVELOPMENT_TEAM'].shellescape}",
      "CURRENT_PROJECT_VERSION=#{build_number}",
      "CODE_SIGN_STYLE=Manual",
      # The value has a space, so it has to survive the shell as one argument.
      "CODE_SIGN_IDENTITY=#{'Apple Distribution'.shellescape}",
      # Each target reads its own variable (project.pbxproj), so one command
      # line signs the app and the extension with different profiles. Setting
      # PROVISIONING_PROFILE_SPECIFIER here would force the app's profile onto
      # the extension and fail the archive.
      "APP_PROFILE_SPECIFIER=#{profile_name.shellescape}",
      "LIVE_ACTIVITIES_PROFILE_SPECIFIER=#{extension_profile_name.shellescape}",
      "SHARE_PROFILE_SPECIFIER=#{share_profile_name.shellescape}"
    ]
    build_settings << "API_BASE_URL=#{ENV['API_BASE_URL'].shellescape}" unless ENV["API_BASE_URL"].to_s.empty?

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      clean: true,
      xcargs: build_settings.join(" "),
      export_options: {
        signingStyle: "manual",
        teamID: ENV["DEVELOPMENT_TEAM"],
        provisioningProfiles: {
          bundle_id => profile_name, extension_id => extension_profile_name, share_id => share_profile_name
        }
      }
    )

    # Internal testers receive builds through an internal group with automatic
    # distribution enabled in App Store Connect (see docs/deployment.md).
    # TESTFLIGHT_EXTERNAL_GROUPS (comma-separated group names) also hands each build to
    # external groups and submits it for Beta App Review. External distribution needs
    # the processed build, so that path waits for processing instead of skipping it.
    external_groups = ENV.fetch("TESTFLIGHT_EXTERNAL_GROUPS", "").split(",").map(&:strip).reject(&:empty?)
    if external_groups.empty?
      upload_to_testflight(
        api_key: api_key,
        app_identifier: bundle_id,
        skip_waiting_for_build_processing: true,
        distribute_external: false
      )
    else
      # The commit subject; the body and trailers are for developers, not testers.
      changelog = ENV.fetch("TESTFLIGHT_CHANGELOG", "").lines.first.to_s.strip
      changelog = "Bug fixes and improvements." if changelog.empty?
      begin
        upload_to_testflight(
          api_key: api_key,
          app_identifier: bundle_id,
          distribute_external: true,
          groups: external_groups,
          changelog: changelog,
          notify_external_testers: true,
          submit_beta_review: true,
          uses_non_exempt_encryption: false,
          wait_processing_timeout_duration: 2400
        )
      rescue => e
        # Apple allows one build per version in Beta App Review at a time. The upload
        # itself already succeeded and internal testers have the build, so a busy review
        # queue is a warning: the next build is submitted once the review finishes.
        raise unless e.message.include?("Another build is in review")
        UI.important("Uploaded, but not sent to #{external_groups.join(', ')}: another build is still in Beta App Review.")
      end
    end
  end

  desc "Create or renew the shared signing certificate and profiles in the match repository"
  lane :signing do
    setup_ci if is_ci
    UI.user_error!("MATCH_PASSWORD is required") if ENV["MATCH_PASSWORD"].to_s.strip.empty?
    api_key = asc_api_key

    # match can only make a profile for an App ID that exists. The app's was
    # registered by hand long ago; the extension's is registered here.
    ensure_bundle_id(live_activities_bundle_id, "DinnerOS Live Activities")
    ensure_bundle_id(share_bundle_id, "DinnerOS Share")

    match(type: "appstore", app_identifier: signed_bundle_ids, api_key: api_key, readonly: false)
    UI.success("Signing assets are stored for #{signed_bundle_ids.join(', ')}; every machine and CI run now shares them.")
  end
  # Sends a build to App Review, from the release Mac (docs/app-store.md). It
  # uploads the listing (metadata/), the screenshots (../store-screenshots, kept
  # out of git), the review contact (metadata/review_information, also out of
  # git), attaches both Plus subscriptions with their review screenshots, and
  # submits. Release is manual after approval.
  #
  #   APP_STORE_CONNECT_ISSUER_ID=<id> APP_STORE_CONNECT_KEY_FILE=~/.appstoreconnect/private_keys/AuthKey_<KEYID>.p8 \
  #     bundle exec fastlane submit_review build:103
  #   ...add dry_run:true to upload everything but not submit.
  desc "Upload the listing and screenshots, attach Plus, and submit a build for App Review"
  lane :submit_review do |options|
    build = options[:build].to_s
    UI.user_error!("Pass build:<number>") if build.empty? && !options[:dry_run]
    key_file = File.expand_path(ENV["APP_STORE_CONNECT_KEY_FILE"].to_s)
    UI.user_error!("Set APP_STORE_CONNECT_KEY_FILE to the .p8 file") unless File.file?(key_file)
    issuer = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip
    issuer_file = File.expand_path("~/.appstoreconnect/issuer_id")
    issuer = File.read(issuer_file).strip if issuer.empty? && File.file?(issuer_file)
    UI.user_error!("Set APP_STORE_CONNECT_ISSUER_ID") if issuer.empty?
    key_id = File.basename(key_file)[/AuthKey_([A-Z0-9]+)\.p8/, 1]
    UI.user_error!("The key file must be named AuthKey_<KEYID>.p8") unless key_id
    api_key = app_store_connect_api_key(key_id: key_id, issuer_id: issuer, key_filepath: key_file)

    root = File.expand_path("../..", __dir__)
    shots = File.join(root, "store-screenshots")
    review = File.join(__dir__, "metadata/review_information")
    contact = %w[first_name last_name email_address phone_number].to_h do |f|
      path = File.join(review, "#{f}.txt")
      UI.user_error!("Missing #{path}") unless File.file?(path)
      [f, File.read(path).strip]
    end
    # deliver wants every screenshot in one folder per language.
    staged = File.join(Dir.tmpdir, "dinneros-shots", "en-US")
    FileUtils.rm_rf(File.dirname(staged))
    FileUtils.mkdir_p(staged)
    Dir[File.join(shots, "{iphone,ipad}", "*.png")].sort.each do |f|
      FileUtils.cp(f, File.join(staged, "#{File.basename(File.dirname(f))}-#{File.basename(f)}"))
    end
    UI.user_error!("No screenshots in #{shots}") if Dir[File.join(staged, "*.png")].empty?

    make_free_everywhere(Spaceship::ConnectAPI::App.find(CompactAppID).id)
    deliver(
      api_key: api_key,
      app_identifier: CompactAppID,
      app_version: "1.0",
      metadata_path: File.join(__dir__, "metadata"),
      screenshots_path: File.dirname(staged),
      overwrite_screenshots: true,
      app_review_information: {
        first_name: contact["first_name"], last_name: contact["last_name"],
        email_address: contact["email_address"], phone_number: contact["phone_number"],
        notes: File.read(File.join(review, "notes.txt")).strip, demo_required: false
      },
      submission_information: { export_compliance_uses_encryption: false, add_id_info_uses_idfa: false },
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      skip_binary_upload: true,
      submit_for_review: false,
      force: true
    )
    app = Spaceship::ConnectAPI::App.find(CompactAppID)
    set_listing(app.id, File.join(__dir__, "metadata"), contact)
    upload_ipad_13(app.id, File.join(shots, "ipad"))
    set_age_rating(app.id)
    rights = app_content_rights(app.id)
    if options[:dry_run]
      # A dry run with build: also puts that build on the version. That is not a submission.
      unless build.empty?
        version = app.get_edit_app_store_version
        chosen = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: "1.0", build_number: build).first
        UI.user_error!("Build 1.0 (#{build}) isn't in App Store Connect yet") unless chosen
        UI.user_error!("Build #{build} is still #{chosen.processing_state}") unless chosen.processing_state == "VALID"
        version.select_build(build_id: chosen.id)
        UI.success("Build #{build} is on version #{version.version_string}.")
      end
      attach_plus_subscriptions(File.join(root, "docs/app-store"), queue: false)
      UI.important("Dry run: the listing, screenshots and subscriptions are set; nothing was submitted.")
      next
    end
    # The content rights answer is a legal statement: Merrill gives it in App
    # Store Connect himself (App Information, Content Rights).
    UI.user_error!("Answer Content Rights in App Store Connect, App Information, first") if rights.nil?
    # Apple reviews a first subscription only with a version that has a build,
    # so the build goes on the version before the subscriptions are queued.
    version = app.get_edit_app_store_version
    chosen = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: "1.0", build_number: build).first
    UI.user_error!("Build 1.0 (#{build}) isn't in App Store Connect yet") unless chosen
    UI.user_error!("Build #{build} is still #{chosen.processing_state}") unless chosen.processing_state == "VALID"
    version.select_build(build_id: chosen.id)
    UI.success("Build #{build} is on version #{version.version_string}.")
    # The first subscriptions must go in the same review submission as the
    # version: open one with the version, queue the subscriptions, then send it.
    client = Spaceship::ConnectAPI.client.tunes_request_client
    open_states = %w[READY_FOR_REVIEW]
    submission = client.get("v1/apps/#{app.id}/reviewSubmissions?filter[platform]=IOS&filter[state]=#{open_states.join(',')}").body["data"].to_a.first
    submission ||= client.post("v1/reviewSubmissions", {
      data: { type: "reviewSubmissions", attributes: { platform: "IOS" },
              relationships: { app: { data: { type: "apps", id: app.id } } } }
    }).body["data"]
    items = client.get("v1/reviewSubmissions/#{submission['id']}/items?include=appStoreVersion").body["data"].to_a
    unless items.any? { |it| it.dig("relationships", "appStoreVersion", "data", "id") == version.id }
      client.post("v1/reviewSubmissionItems", {
        data: { type: "reviewSubmissionItems", relationships: {
          reviewSubmission: { data: { type: "reviewSubmissions", id: submission["id"] } },
          appStoreVersion: { data: { type: "appStoreVersions", id: version.id } }
        } }
      })
    end
    UI.success("Version #{version.version_string} is in review submission #{submission['id']}.")
    attach_plus_subscriptions(File.join(root, "docs/app-store"), queue: true)
    client.patch("v1/reviewSubmissions/#{submission['id']}", {
      data: { type: "reviewSubmissions", id: submission["id"], attributes: { submitted: true } }
    })
    UI.success("Build #{build} is submitted for App Review.")
  end
end
