<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AppIdentifierPrefix</key>
	<string>$(AppIdentifierPrefix)</string>
	<key>APIBaseURL</key>
	<string>$(API_BASE_URL)</string>
	<key>AppEnvironment</key>
	<string>$(APP_ENVIRONMENT)</string>
	<key>AppLinkDomain</key>
	<string>$(APP_LINK_DOMAIN)</string>
	<key>AppURLScheme</key>
	<string>$(APP_URL_SCHEME)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>$(APP_BUNDLE_ID_BASE).invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(APP_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>GoogleIOSClientID</key>
	<string>$(GOOGLE_IOS_CLIENT_ID)</string>
	<key>RevenueCatAPIKey</key>
	<string>$(REVENUECAT_API_KEY)</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Autopilot checks how busy your evenings are to suggest quicker dinners on busy nights. Only "free", "some", or "busy" leaves your iPhone, never your events.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Your location helps suggest dinners that suit the weather and fills in your ZIP code when you look for a store. DinnerOS only gets your ZIP code and a rough forecast, like cold or rainy, never your exact location.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Adds your week's grocery list to a Reminders list so you can use it while you shop.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
