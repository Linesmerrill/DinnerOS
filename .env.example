# DinnerOS API configuration.
#
# Copy to `.env` for local development (`cp .env.example .env`). `.env` is
# git-ignored. In deployed environments (Heroku) set these as config vars.
# Never put real credentials in this file. See docs/deployment.md for where
# each credential comes from.

# --- Application -------------------------------------------------------------
# Display name used in logs, emails, and API metadata. The product name is a
# working title; change it here rather than in code.
APP_NAME=DinnerOS
# development | production
APP_ENV=development
PORT=8080
# debug | info | warn | error
LOG_LEVEL=debug
# text (human readable) | json (structured, used in production)
LOG_FORMAT=text
# Maximum accepted request body size in bytes.
HTTP_MAX_BODY_BYTES=1048576
# Body limit for POST /api/v1/households/{householdId}/recipes/import, which
# replaces HTTP_MAX_BODY_BYTES on that route only (default 32 MB).
RECIPE_IMPORT_MAX_BYTES=33554432

# --- MongoDB -----------------------------------------------------------------
# Local: `docker compose up -d mongo`. Production: MongoDB Atlas connection string.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=dinneros
# Tests only: enables MongoDB integration tests (`make api-test-integration`).
# Each test uses and drops its own throwaway database.
# MONGODB_TEST_URI=mongodb://localhost:27017

# --- Authentication (Phase 2) ------------------------------------------------
# Secret used to sign DinnerOS access tokens (HS256). Base64, at least 32 bytes
# once decoded. Generate: `openssl rand -base64 48`
# Required in production. In development, leaving it empty makes the API use a
# random per-process key (sessions end whenever the server restarts).
AUTH_TOKEN_SIGNING_KEY=
# Apple Developer → Membership details → Team ID. With APPLE_BUNDLE_ID it forms
# the app ID in GET /.well-known/apple-app-site-association, which lets the iOS
# app open invitation links. Empty: that file isn't served.
APPLE_TEAM_ID=
# Audience of Sign in with Apple identity tokens. Must match the iOS app bundle
# identifier (ios/Config/Shared.xcconfig).
APPLE_BUNDLE_ID=com.linesmerrill.dinneros
# Apple Developer → Identifiers → Services IDs (only needed for web sign-in flows;
# not read by the API yet)
APPLE_SERVICE_ID=
# Audience of Google ID tokens: Google Cloud Console → Google Auth Platform →
# Clients → iOS client ID (a public identifier). Empty disables Google sign-in.
GOOGLE_CLIENT_ID=
# Development only: mounts POST /api/v1/auth/dev, which signs in with an
# UNVERIFIED identity for simulator and integration testing. Takes effect only
# when APP_ENV=development; the API refuses to start with it set in production.
AUTH_DEV_LOGIN_ENABLED=false

# --- Email and invitations (Phase 3) -----------------------------------------
# resend | log. Defaults to resend when RESEND_API_KEY is set, otherwise log.
# `log` doesn't send anything: it logs that an invitation email was suppressed
# (and, in development only, the invite code). Production requires resend.
EMAIL_PROVIDER=log
# resend.com → API Keys (a send-only key is enough). Required for resend.
RESEND_API_KEY=
# Verified sender on your Resend domain, e.g. "DinnerOS <invites@example.com>".
# Required for resend.
EMAIL_FROM=
# Invitation link in emails, before the token. The token is appended as a
# `#token=` fragment, which browsers never send, so it can't reach server logs.
# The default is the API's /invite landing page, which the iOS app opens as a
# universal link. A value ending in `=` (the old `dinneros://invite?token=`) has
# the token appended directly.
APP_INVITE_URL_BASE=https://api.tlps.dev/invite
# The iOS app's custom URL scheme (APP_URL_SCHEME in ios/Config/Shared.xcconfig).
# The /invite landing page's "Open" button links to <scheme>://invite?token=...
APP_URL_SCHEME=dinneros

# --- Recommendations (future) ------------------------------------------------
# local | autopilot
RECOMMENDATION_PROVIDER=local
AUTOPILOT_BASE_URL=
AUTOPILOT_API_KEY=

# --- OpenAI (future, backend only — never in the iOS app) ---------------------
OPENAI_API_KEY=
